parameters:
    bootstrapFiles:
        - phpstan-bootstrap.php
    level: max
    paths:
        - ../src
        - ../tests
    treatPhpDocTypesAsCertain: false
    # The baseline covers the findings of every CI job, and some of them only occur with certain dependency
    # versions (e.g. Symfony 6.4). Report unmatched entries again once the baseline is empty.
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # Symfony 6.4 types the return of Crawler::each() as array, 7.4 and later as list<R>
        -
            message: '#^Method Protung\\EasyAdminPlusBundle\\Test\\Controller\\DashboardControllerTestCase::extractMenuItems(BeforeEasyAdmin53)?\(\) should return .+ but returns array\.$#'
            identifier: return.type
            path: ../src/Test/Controller/DashboardControllerTestCase.php
        # EasyAdmin's ActionsExtensionInterface leaves out the types of the generic AdminContext, so an implementation
        # can neither specify them (not contravariant) nor leave them out
        -
            identifier: missingType.generics
            path: ../src/Action/ConfirmationModalActionsExtension.php
            count: 2
        # askConfirmation() only takes a closure since EasyAdmin 5.10, so its closures are reported before
        -
            message: '#^Parameter \#1 \$confirmation of method EasyCorp\\Bundle\\EasyAdminBundle\\Config\\Action::askConfirmation\(\) expects bool\|string\|Symfony\\Contracts\\Translation\\TranslatableInterface, Closure given\.$#'
            identifier: argument.type
            path: ../tests/Test/TestApplication/Controller/ConfirmationModalCrudController.php
            count: 2
        # AdminRouteGenerator::usesPrettyUrls() only exists in EasyAdmin 4, EasyAdmin 5 always uses pretty URLs
        -
            message: '#^Call to an undefined method EasyCorp\\Bundle\\EasyAdminBundle\\Router\\AdminRouteGenerator::usesPrettyUrls\(\)\.$#'
            identifier: method.notFound
            path: ../src/Field/Configurator/EntityConfigurator.php
            count: 1
        # CrudPermissionCheckerInterface only exists since EasyAdmin 5.9, EntityConfigurator links every target before
        -
            message: '#^.+ EasyCorp\\Bundle\\EasyAdminBundle\\Contracts\\Security\\CrudPermissionCheckerInterface( as its type)?\.$#'
            identifier: class.notFound
            path: ../src/Field/Configurator/EntityConfigurator.php
            count: 3
        # BaseCrudDtoController::handleFormRequest() is a byte-identical copy of EasyAdmin's, so it keeps EasyAdmin's
        # untyped form and nested access to the posted data
        -
            message: '#^Method Protung\\EasyAdminPlusBundle\\Controller\\BaseCrudDtoController::handleFormRequest\(\) has parameter \$form with generic interface Symfony\\Component\\Form\\FormInterface but does not specify its types: TData$#'
            identifier: missingType.generics
            path: ../src/Controller/BaseCrudDtoController.php
            count: 1
        -
            message: "#^Cannot access offset 'btn' on mixed\\.$#"
            identifier: offsetAccess.nonOffsetAccessible
            path: ../src/Controller/BaseCrudDtoController.php
            count: 1

includes:
    - phpstan-baseline.neon
    - ../vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - ../vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - ../vendor/phpstan/phpstan-phpunit/extension.neon
    - ../vendor/phpstan/phpstan-strict-rules/rules.neon
    - ../vendor/phpstan/phpstan-symfony/extension.neon
    - ../vendor/php-standard-library/phpstan-extension/extension.neon
