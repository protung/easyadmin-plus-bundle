parameters:
    bootstrapFiles:
        - phpstan-bootstrap.php
    level: max
    paths:
        - ../src
        - ../tests
    treatPhpDocTypesAsCertain: false
    # The baseline covers the findings of every CI job, and some of them only occur with certain dependency
    # versions (e.g. Symfony 6.4). Report unmatched entries again once the baseline is empty.
    reportUnmatchedIgnoredErrors: false

includes:
    - phpstan-baseline.neon
    - ../vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - ../vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - ../vendor/phpstan/phpstan-phpunit/extension.neon
    - ../vendor/phpstan/phpstan-strict-rules/rules.neon
    - ../vendor/phpstan/phpstan-symfony/extension.neon
    - ../vendor/php-standard-library/phpstan-extension/extension.neon
